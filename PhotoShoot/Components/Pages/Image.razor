@page "/image/{Id}"
@rendermode InteractiveServer
@implements IDisposable
@inject IImageCatalog Catalog
@inject IImageNotificationService Notifications
@inject NavigationManager NavigationManager

<PageTitle>@(_image?.DisplayName ?? "Image not found")</PageTitle>

@if (_image is null)
{
    <h1>Image not found</h1>
    <p>The requested image is not available in the catalog.</p>
    <a href="/" class="btn btn-primary">Back to gallery</a>
}
else
{
    <h1>@_image.DisplayName</h1>

    <div class="mb-3">
        <a href="/" class="btn btn-outline-secondary">Back to gallery</a>
    </div>

    <div class="row g-4">
        <div class="col-12 col-lg-8">
            <div class="card shadow-sm">
                <img src="@_image.ImageUrl" class="card-img-top" alt="@_image.DisplayName" />
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Details</h5>
                    <dl class="row mb-0">
                        <dt class="col-5">File</dt>
                        <dd class="col-7">@_image.FileName</dd>

                        <dt class="col-5">Created</dt>
                        <dd class="col-7">@_image.CreatedUtc.ToLocalTime().ToString("g")</dd>

                        <dt class="col-5">Thumbnail</dt>
                        <dd class="col-7"><img src="@_image.ThumbnailUrl" class="img-fluid rounded" alt="@_image.DisplayName thumbnail" /></dd>
                    </dl>
                </div>
            </div>

            <div class="card shadow-sm mt-4">
                <div class="card-body">
                    <h5 class="card-title">Histogram</h5>
                    <img src="@_image.HistogramUrl" class="img-fluid rounded" alt="@_image.DisplayName histogram" />
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private MonitoredImage? _image;

    protected override void OnInitialized()
    {
        Notifications.ImageAdded += OnImageAdded;
    }

    protected override void OnParametersSet()
    {
        _image = Catalog.GetById(Id);
    }

    private void OnImageAdded(MonitoredImage newImage)
    {
        _ = InvokeAsync(() =>
        {
            NavigationManager.NavigateTo($"/image/{newImage.Id}");
        });
    }

    public void Dispose()
    {
        Notifications.ImageAdded -= OnImageAdded;
    }
}
