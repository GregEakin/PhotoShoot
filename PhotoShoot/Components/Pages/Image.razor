@page "/image/{Id}"
@rendermode InteractiveServer
@implements IDisposable
@inject IImageCatalog Catalog
@inject IImageNotificationService Notifications
@inject NavigationManager NavigationManager
@inject ILogger<Image> Logger

<PageTitle>@(_image?.DisplayName ?? "Image not found")</PageTitle>

@if (_image is null)
{
    <h1>Image not found</h1>
    <p>The requested image is not available in the catalog.</p>
    <a href="/" class="btn btn-primary">Back to gallery</a>
}
else
{
    <h1>@_image.DisplayName</h1>

    <div class="mb-3">
        <a href="/" class="btn btn-outline-secondary">Back to gallery</a>
    </div>

    <div class="row g-4">
        <div class="col-12 col-lg-8">
            <div class="card shadow-sm">
                <img src="@_image.ImageUrl" class="card-img-top" alt="@_image.DisplayName" />
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Details</h5>
                    <dl class="row mb-0">
                        <dt class="col-3">File</dt>
                        <dd class="col-9">@_image.FileName</dd>

                        <dt class="col-3">Created</dt>
                        <dd class="col-9">@_image.CreatedUtc.ToLocalTime().ToString("g")</dd>

                        <dt class="col-3">Metadata</dt>
                        <dd class="col-9">@_image.Metadata</dd>

                        <dt class="col-3">Histogram</dt>
                        <dd class="col-9"><img src="@_image.HistogramUrl" class="img-fluid rounded" alt="@_image.DisplayName histogram" /></dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private MonitoredImage? _image;

    protected override void OnInitialized()
    {
        Notifications.ImageAdded += OnImageAdded;

        if (Logger.IsEnabled(LogLevel.Debug))
        {
            Logger.LogDebug(
                "Image component subscribed to ImageAdded on instance {InstanceName}. Current route id: {ImageId}.",
                Environment.MachineName,
                Id);
        }
    }

    protected override void OnParametersSet()
    {
        _image = Catalog.GetById(Id);
    }

    private void OnImageAdded(MonitoredImage newImage)
    {
        _ = InvokeAsync(() =>
        {
            if (Logger.IsEnabled(LogLevel.Debug))
            {
                Logger.LogDebug(
                    "Image component received ImageAdded for {ImageId} on instance {InstanceName}. Navigating to image page.",
                    newImage.Id,
                    Environment.MachineName);
            }

            NavigationManager.NavigateTo($"image/{newImage.Id}");
        });
    }

    public void Dispose()
    {
        Notifications.ImageAdded -= OnImageAdded;

        if (Logger.IsEnabled(LogLevel.Debug))
        {
            Logger.LogDebug("Image component unsubscribed from ImageAdded on instance {InstanceName}.", Environment.MachineName);
        }
    }
}
