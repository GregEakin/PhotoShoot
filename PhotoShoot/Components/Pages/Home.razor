@page "/"
@rendermode InteractiveServer
@implements IDisposable
@inject IImageCatalog Catalog
@inject IImageNotificationService Notifications
@inject NavigationManager NavigationManager
@inject ILogger<Home> Logger

<PageTitle>PhotoShoot Gallery</PageTitle>

<h1>PhotoShoot Gallery</h1>

@if (_images.Count == 0)
{
    <p class="text-muted">Waiting for new pictures to arrive in the monitored folder.</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var image in _images)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <a href="image/@image.Id" class="text-decoration-none text-reset">
                        <img src="@image.ThumbnailUrl" class="card-img-top" alt="@image.DisplayName" />
                    </a>
                    <div class="card-body">
                        <h5 class="card-title">@image.DisplayName</h5>
                        <p class="card-text text-muted">@image.Metadata</p>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<MonitoredImage> _images = [];

    protected override void OnInitialized()
    {
        _images = [.. Catalog.GetAll()];
        Notifications.ImageAdded += OnImageAdded;

        if (Logger.IsEnabled(LogLevel.Information))
        {
            Logger.LogInformation(
                "Home component subscribed to ImageAdded on instance {InstanceName}. Current image count: {ImageCount}.",
                Environment.MachineName,
                _images.Count);
        }
    }

    private void OnImageAdded(MonitoredImage image)
    {
        _ = InvokeAsync(() =>
        {
            _images = [image, .. _images.Where(existing => !string.Equals(existing.Id, image.Id, StringComparison.OrdinalIgnoreCase))];

            if (Logger.IsEnabled(LogLevel.Information))
            {
                Logger.LogInformation(
                    "Home component received ImageAdded for {ImageId} on instance {InstanceName}. Navigating to image page.",
                    image.Id,
                    Environment.MachineName);
            }

            NavigationManager.NavigateTo($"image/{image.Id}");
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Notifications.ImageAdded -= OnImageAdded;

        if (Logger.IsEnabled(LogLevel.Information))
        {
            Logger.LogInformation("Home component unsubscribed from ImageAdded on instance {InstanceName}.", Environment.MachineName);
        }
    }
}
