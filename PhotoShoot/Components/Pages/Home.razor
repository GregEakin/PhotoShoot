@page "/"
@rendermode InteractiveServer
@implements IDisposable
@inject IImageCatalog Catalog
@inject IImageNotificationService Notifications
@inject NavigationManager NavigationManager

<PageTitle>PhotoShoot Gallery</PageTitle>

<h1>PhotoShoot Gallery</h1>

@if (images.Count == 0)
{
    <p class="text-muted">Waiting for new pictures to arrive in the monitored folder.</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var image in images)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <a href="image/@image.Id" class="text-decoration-none text-reset">
                        <img src="@image.ThumbnailUrl" class="card-img-top" alt="@image.DisplayName" />
                    </a>
                    <div class="card-body">
                        <h5 class="card-title">@image.DisplayName</h5>
                        <p class="card-text text-muted">@image.FileName</p>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<MonitoredImage> images = [];

    protected override void OnInitialized()
    {
        images = Catalog.GetAll().ToList();
        Notifications.ImageAdded += OnImageAdded;
    }

    private void OnImageAdded(MonitoredImage image)
    {
        _ = InvokeAsync(() =>
        {
            images = [image, .. images.Where(existing => !string.Equals(existing.Id, image.Id, StringComparison.OrdinalIgnoreCase))];
            NavigationManager.NavigateTo($"/image/{image.Id}");
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Notifications.ImageAdded -= OnImageAdded;
    }
}
