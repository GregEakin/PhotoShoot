{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ImageMonitor": {
    "InputFolder": "incoming",
    "ThumbnailFolder": "incoming/thumbnails",
    "HistogramFolder": "incoming/histograms",
    "PublicImagePath": "/images",
    "PublicThumbnailPath": "/thumbnails",
    "PublicHistogramPath": "/histograms",
    "PollIntervalSeconds": 2,
    "SupportedExtensions": [ ".jpg", ".jpeg", ".png", ".gif", ".webp", ".bmp" ]
  }
}
