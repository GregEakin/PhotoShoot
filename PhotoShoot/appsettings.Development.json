{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ImageMonitor": {
    "InputFolder": "C:\\PhotoShoot\\Incoming",
    "ThumbnailFolder": "C:\\PhotoShoot\\Incoming\\thumbnails",
    "PublicImagePath": "/images",
    "PublicThumbnailPath": "/thumbnails",
    "PollIntervalSeconds": 2,
    "SupportedExtensions": [ ".jpg", ".jpeg", ".png", ".gif", ".webp", ".bmp" ]
  }
}
