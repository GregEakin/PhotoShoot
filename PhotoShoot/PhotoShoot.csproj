<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Magick.NET-Q16-AnyCPU" Version="14.16.0" />
  </ItemGroup>

  <!-- Suppress Magick.NET wildcard resx glob that fails on Linux -->
  <Target Name="RemoveMagickResxFiles" BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <EmbeddedResource Remove="**/*.resx" />
    </ItemGroup>
  </Target>

</Project>
